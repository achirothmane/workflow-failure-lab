{
  "profile": "eba.temporal/v1",
  "contract_version": "eba.integration/v0.1",
  "clock": {
    "input": "explicit RFC3339 instant with timezone",
    "interval": "[not_before, expires_at)",
    "future_observation_skew_seconds": 0
  },
  "absence_rules": {
    "AssumptionState.valid_until": "null is allowed only when the producing profile explicitly relies on non-wall-clock invalidation; a finite supporting input may not be erased",
    "AuthorityGrant.expires_at": "required and finite",
    "BudgetReservation.expires_at": "required and finite; bounded by the budget lifetime"
  },
  "cases": [
    {"id": "T01-assumption-before-expiry", "kind": "AssumptionState", "now": "2026-09-28T11:59:59Z", "valid_until": "2026-09-28T12:00:00Z", "expect": "ACCEPT"},
    {"id": "T02-assumption-at-expiry", "kind": "AssumptionState", "now": "2026-09-28T12:00:00Z", "valid_until": "2026-09-28T12:00:00Z", "expect": "REJECT"},
    {"id": "T03-assumption-null-explicit", "kind": "AssumptionState", "now": "2026-09-28T12:00:00Z", "valid_until": null, "expect": "PROFILE_SPECIFIC"},
    {"id": "T04-assumption-wrong-type", "kind": "AssumptionState", "now": "2026-09-28T12:00:00Z", "valid_until": 123, "expect": "REJECT"},
    {"id": "T05-authority-before-expiry", "kind": "AuthorityGrant", "now": "2026-09-28T11:59:59Z", "not_before": "2026-09-28T11:00:00Z", "expires_at": "2026-09-28T12:00:00Z", "expect": "ACCEPT"},
    {"id": "T06-authority-at-expiry", "kind": "AuthorityGrant", "now": "2026-09-28T12:00:00Z", "not_before": "2026-09-28T11:00:00Z", "expires_at": "2026-09-28T12:00:00Z", "expect": "REJECT"},
    {"id": "T07-authority-missing-expiry", "kind": "AuthorityGrant", "now": "2026-09-28T11:30:00Z", "not_before": "2026-09-28T11:00:00Z", "expect": "REJECT"},
    {"id": "T08-future-observation", "kind": "Evidence", "now": "2026-09-28T12:00:00Z", "observed_at": "2026-09-28T12:00:01Z", "expect": "REJECT"},
    {"id": "T09-budget-at-expiry", "kind": "BudgetSnapshot", "now": "2026-09-28T12:00:00Z", "valid_until": "2026-09-28T12:00:00Z", "expect": "REJECT"},
    {"id": "T10-reservation-bounded-by-budget", "kind": "BudgetReservation", "created_at": "2026-09-28T11:00:00Z", "requested_expires_at": "2026-09-28T13:00:00Z", "budget_valid_until": "2026-09-28T12:00:00Z", "effective_expires_at": "2026-09-28T12:00:00Z", "expect": "ACCEPT"},
    {"id": "T11-equal-instant-offset", "kind": "Timestamp", "a": "2026-09-28T12:00:00Z", "b": "2026-09-28T14:00:00+02:00", "expect": "EQUAL"}
  ]
}
