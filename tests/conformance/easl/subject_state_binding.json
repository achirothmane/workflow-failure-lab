{
  "version": 1,
  "primitive": "subject_state_binding",
  "cases": [
    {
      "name": "matching_binding",
      "bindings": [
        {
          "id": "target-state",
          "expected": "sha256:abc",
          "observed": "sha256:abc"
        }
      ],
      "required": ["target-state"],
      "want_state": "VALID",
      "want_evidence_status": "SUFFICIENT",
      "want_invalidated_bindings": []
    },
    {
      "name": "changed_binding",
      "bindings": [
        {
          "id": "target-state",
          "expected": "sha256:before",
          "observed": "sha256:after"
        }
      ],
      "required": ["target-state"],
      "want_state": "INVALID",
      "want_evidence_status": "INSUFFICIENT",
      "want_invalidated_bindings": ["target-state"]
    },
    {
      "name": "multiple_changed_bindings",
      "bindings": [
        {
          "id": "run-attempt",
          "expected": "json:1",
          "observed": "json:2"
        },
        {
          "id": "head-sha",
          "expected": "json:\"abc\"",
          "observed": "json:\"def\""
        }
      ],
      "required": ["head-sha", "run-attempt"],
      "want_state": "INVALID",
      "want_evidence_status": "INSUFFICIENT",
      "want_invalidated_bindings": ["head-sha", "run-attempt"]
    },
    {
      "name": "unknown_required_binding",
      "bindings": [],
      "required": ["missing"],
      "want_error_contains": "requires unknown state binding"
    },
    {
      "name": "duplicate_binding_id",
      "bindings": [
        {
          "id": "target-state",
          "expected": "a",
          "observed": "a"
        },
        {
          "id": "target-state",
          "expected": "a",
          "observed": "a"
        }
      ],
      "required": ["target-state"],
      "want_error_contains": "duplicate state binding id"
    },
    {
      "name": "empty_expected_token",
      "bindings": [
        {
          "id": "target-state",
          "expected": "",
          "observed": "current"
        }
      ],
      "required": ["target-state"],
      "want_error_contains": "requires expected and observed tokens"
    },
    {
      "name": "empty_observed_token",
      "bindings": [
        {
          "id": "target-state",
          "expected": "expected",
          "observed": ""
        }
      ],
      "required": ["target-state"],
      "want_error_contains": "requires expected and observed tokens"
    }
  ]
}
